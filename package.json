{
  "name": "@lvntd/alterego",
  "version": "0.2.0",
  "description": "Launch multiple isolated Chromium browser windows at once",
  "type": "module",
  "bin": {
    "ego": "./dist/cli.js",
    "alterego": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "browser",
    "chrome",
    "chromium",
    "cli",
    "incognito",
    "multi-window"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "ink": "^6.8.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^6.1.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
